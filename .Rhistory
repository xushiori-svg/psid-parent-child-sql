import pandas as pd
RAW_DIR = Path("data/raw")
DB_FILE = Path("data/psid.db")
def read_psid_extract():
# The Data Center gives a zip with a fixed-width text file (.txt) and a
# Stata do-file (.do). The do-file says where each variable sits in a line,
# for example "ER30001  2 - 5" means columns 2 to 5.
# works with the zip file or with the unzipped folder
zips = list(RAW_DIR.glob("*.zip"))
if zips:
z = zipfile.ZipFile(zips[0])
do_name = [n for n in z.namelist() if n.endswith(".do") and "formats" not in n][0]
txt_name = [n for n in z.namelist() if n.endswith(".txt")][0]
do_text = z.read(do_name).decode("latin-1")
txt_file = z.open(txt_name)
else:
do_file = [f for f in RAW_DIR.rglob("*.do") if "formats" not in f.name][0]
txt_name = do_file.with_suffix(".txt")
do_text = do_file.read_text(encoding="latin-1")
txt_file = open(txt_name, "rb")
print("Reading", txt_name)
infix = do_text[do_text.lower().index("infix"):do_text.lower().index("using")]
positions = re.findall(r"(\w+)\s+(\d+)\s*-\s*(\d+)", infix)
# keep only the variables we need
var_map = pd.read_csv("data/psid_variables.csv", dtype=str).fillna("")
needed = {"ER30001", "ER30002", "ER32000"}
for col in ["interview_no", "sequence_no", "relation_to_head", "age", "family_income"]:
needed.update(v for v in var_map[col] if v)
names, colspecs = [], []
for name, first, last in positions:
if name.upper() in needed:
names.append(name.upper())
colspecs.append((int(first) - 1, int(last)))
missing = needed - set(names)
if missing:
raise ValueError(f"These variables are not in the download: {sorted(missing)}")
data = pd.read_fwf(txt_file, colspecs=colspecs, names=names, header=None)
txt_file.close()
return data
wide = read_psid_extract().copy()
wide.columns = [c.upper() for c in wide.columns]
print("Raw extract:", wide.shape[0], "people,", wide.shape[1], "columns")
# variable names for each year (from the PSID cross-year index)
var_map = pd.read_csv("data/psid_variables.csv", dtype=str).fillna("")
# one row per person
# person id = 1968 interview number * 1000 + person number
wide["pid"] = wide["ER30001"] * 1000 + wide["ER30002"]
persons = pd.DataFrame({
"pid": wide["pid"],
"id1968": wide["ER30001"],
"sex": wide["ER32000"],
})
# one row per person and year (wide -> long)
rows = []
for _, v in var_map.iterrows():
year = int(v["year"])
one = pd.DataFrame({
"pid": wide["pid"],
"year": year,
"family_id": wide[v["interview_no"]],
"relation": wide[v["relation_to_head"]],
"age": wide[v["age"]],
"family_income": wide[v["family_income"]],
})
# 1968 has no sequence number; a person was in a 1968 family
# if their relation to head is not 0
if v["sequence_no"] == "":
one["seq"] = (one["relation"] > 0).astype(int)
else:
one["seq"] = wide[v["sequence_no"]]
rows.append(one)
person_years = pd.concat(rows, ignore_index=True)
# keep people who actually lived in a PSID family that year (sequence 1-20)
person_years = person_years[
(person_years["family_id"] > 0)
& (person_years["seq"] >= 1)
& (person_years["seq"] <= 20)
]
# the codes for relation to head changed in 1983 (1 -> 10, 2 -> 20, 3 -> 30)
person_years["role"] = "other"
person_years.loc[person_years["relation"].isin([1, 10]), "role"] = "head"
person_years.loc[person_years["relation"].isin([2, 20, 22]), "role"] = "spouse"
person_years.loc[person_years["relation"].isin([3, 30]), "role"] = "child"
# 9999999 is a missing value code for family income in 1994 and 1995
person_years.loc[person_years["family_income"] >= 9999999, "family_income"] = None
# age 0 or 999 means missing
person_years.loc[(person_years["age"] == 0) | (person_years["age"] >= 999), "age"] = None
print("Person-year rows:", len(person_years))
if DB_FILE.exists():
DB_FILE.unlink()
conn = sqlite3.connect(DB_FILE)
persons.to_sql("persons", conn, index=False)
person_years.to_sql("person_years", conn, index=False)
# family table: one row per family and year
conn.execute("""
CREATE TABLE families AS
SELECT
year,
family_id,
MAX(family_income) AS family_income,
COUNT(*) AS family_size
FROM person_years
GROUP BY year, family_id;
""")
conn.execute("CREATE INDEX idx_py ON person_years (year, family_id);")
conn.execute("CREATE INDEX idx_py_pid ON person_years (pid);")
conn.execute("CREATE INDEX idx_fam ON families (year, family_id);")
conn.commit()
for t in ["persons", "person_years", "families"]:
n = conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
print(t, n)
conn.close()
print("Saved", DB_FILE)
# Run the SQL files that match children to parents and build income measures.
# Run from the project folder: python scripts/02_match_with_sql.py
from pathlib import Path
import sqlite3
import pandas as pd
DB_FILE = Path("data/psid.db")
CLEAN_DIR = Path("data/clean")
CLEAN_DIR.mkdir(parents=True, exist_ok=True)
conn = sqlite3.connect(DB_FILE)
for sql_file in ["sql/01_parent_child.sql",
"sql/02_parent_income.sql",
"sql/03_child_income.sql"]:
print("Running", sql_file)
conn.executescript(Path(sql_file).read_text())
# quick look at the match
print(pd.read_sql("""
SELECT
COUNT(*) AS children,
COUNT(DISTINCT parent_id) AS parents,
AVG(years_together) AS avg_years_together
FROM parent_child;
""", conn))
# matched sample: one row per child
matched = pd.read_sql("""
SELECT
pc.child_id,
pc.parent_id,
pc.child_birth_year,
s.sex AS child_sex,
p.p_inc_1968,
p.p_inc_avg,
p.p_years,
p.parent_age_1968,
c.c_inc_avg,
c.c_years
FROM parent_child AS pc
LEFT JOIN persons AS s
ON pc.child_id = s.pid
LEFT JOIN parent_income AS p
ON pc.child_id = p.child_id
LEFT JOIN child_income AS c
ON pc.child_id = c.child_id;
""", conn)
child_years = pd.read_sql("SELECT * FROM child_income_years;", conn)
conn.close()
matched.to_csv(CLEAN_DIR / "matched_sample.csv", index=False)
child_years.to_csv(CLEAN_DIR / "child_income_years.csv", index=False)
print("Matched children:", len(matched))
print("Saved files to", CLEAN_DIR)
# Estimate the intergenerational elasticity (IGE) and the rank-rank slope.
# Run from the project folder: python scripts/03_estimate_ige.py
from pathlib import Path
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
RESULTS_DIR = Path("results")
RESULTS_DIR.mkdir(exist_ok=True)
matched = pd.read_csv("data/clean/matched_sample.csv")
child_years = pd.read_csv("data/clean/child_income_years.csv")
def ols(y, x):
# simple regression y = a + b*x, returns slope, robust standard error, n
X = np.column_stack([np.ones(len(x)), x])
beta = np.linalg.lstsq(X, y, rcond=None)[0]
resid = y - X @ beta
n = len(y)
bread = np.linalg.inv(X.T @ X)
meat = X.T @ (X * (resid ** 2)[:, None])
vcov = bread @ meat @ bread * n / (n - 2)
return beta[1], np.sqrt(vcov[1, 1]), n
def log_ige(df, child_col, parent_col):
# log(child income) = a + b * log(parent income)
return ols(np.log(df[child_col].values), np.log(df[parent_col].values))
def rank_slope(df, child_col, parent_col):
# child percentile rank = a + b * parent percentile rank
# ranks go from 0 to 100 and are computed inside the sample used
child_rank = df[child_col].rank(pct=True).values * 100
parent_rank = df[parent_col].rank(pct=True).values * 100
return ols(child_rank, parent_rank)
def income_at_age(age):
# child income observed at this age (or one year later, since the PSID
# is every two years after 1997); keep the first one for each child
d = child_years[(child_years["age"] >= age) & (child_years["age"] <= age + 1)]
d = d.sort_values(["child_id", "age", "year"]).drop_duplicates("child_id")
return d[["child_id", "rel_income"]].rename(columns={"rel_income": f"c_inc_age{age}"})
# parents: need income in 1968 and at least 3 of the 5 years 1968-1972
parents_ok = matched[(matched["p_years"] >= 3) & matched["p_inc_1968"].notna()]
# 1. life-cycle pattern: child income measured at one age, from 25 to 45
rows = []
for age in range(25, 46):
d = parents_ok.merge(income_at_age(age), on="child_id")
col = f"c_inc_age{age}"
b, se, n = log_ige(d, col, "p_inc_avg")
r, rse, _ = rank_slope(d, col, "p_inc_avg")
rows.append({"child_age": age, "log_ige": b, "log_ige_se": se,
"rank_slope": r, "rank_slope_se": rse, "n": n})
lifecycle = pd.DataFrame(rows)
lifecycle.to_csv(RESULTS_DIR / "lifecycle_estimates.csv", index=False)
print(lifecycle.round(3))
# 2. main table on one common sample
# children with income at age 27-28, at age 40-41, and at least 3 years at 35-44
common = (
parents_ok[parents_ok["c_years"] >= 3]
.merge(income_at_age(27), on="child_id")
.merge(income_at_age(40), on="child_id")
)
specs = [
("Parent 1968 only", "Child at age 27", "p_inc_1968", "c_inc_age27"),
("Parent 1968 only", "Child at age 40", "p_inc_1968", "c_inc_age40"),
("Parent 1968-1972 average", "Child at age 27", "p_inc_avg", "c_inc_age27"),
("Parent 1968-1972 average", "Child at age 40", "p_inc_avg", "c_inc_age40"),
("Parent 1968 only", "Child age 35-44 average", "p_inc_1968", "c_inc_avg"),
("Parent 1968-1972 average", "Child age 35-44 average", "p_inc_avg", "c_inc_avg"),
]
table = []
for p_label, c_label, p_col, c_col in specs:
b, se, n = log_ige(common, c_col, p_col)
r, rse, _ = rank_slope(common, c_col, p_col)
table.append({"parent_income": p_label, "child_income": c_label,
"log_ige": round(b, 3), "log_ige_se": round(se, 3),
"rank_slope": round(r, 3), "rank_slope_se": round(rse, 3),
"n": n})
table = pd.DataFrame(table)
table.to_csv(RESULTS_DIR / "ige_table.csv", index=False)
print(table)
# sample description
desc = pd.DataFrame({
"item": ["Children matched to a parent (SQL)",
"Parents with 1968 income and 3+ years in 1968-1972",
"Common sample used in the main table",
"Child birth years in common sample",
"Mean parent age in 1968 (common sample)",
"Mean years of child income at 35-44 (common sample)"],
"value": [len(matched), len(parents_ok), len(common),
f"{common['child_birth_year'].min():.0f}-{common['child_birth_year'].max():.0f}",
round(common["parent_age_1968"].mean(), 1),
round(common["c_years"].mean(), 1)],
})
desc.to_csv(RESULTS_DIR / "sample_description.csv", index=False)
print(desc)
# figure 1: estimates by the age when child income is measured
long_run_log = table.iloc[5]["log_ige"]
long_run_rank = table.iloc[5]["rank_slope"]
fig, axes = plt.subplots(1, 2, figsize=(11, 4.2))
for ax, col, ref, title in [
(axes[0], "log_ige", long_run_log, "Log-log IGE"),
(axes[1], "rank_slope", long_run_rank, "Rank-rank slope"),
]:
lo = lifecycle[col] - 1.96 * lifecycle[col + "_se"]
hi = lifecycle[col] + 1.96 * lifecycle[col + "_se"]
ax.fill_between(lifecycle["child_age"], lo, hi, color="#2a6f97", alpha=0.15)
ax.plot(lifecycle["child_age"], lifecycle[col], color="#2a6f97", marker="o",
markersize=4, label="Child income from one year at this age")
ax.axhline(ref, color="#c44536", linestyle="--",
label="Child income averaged over ages 35-44")
ax.set_title(title)
ax.set_xlabel("Child age when income is measured")
ax.set_ylim(0, 0.8)
ax.set_xticks(range(25, 46, 5))
ax.grid(alpha=0.3)
axes[0].set_ylabel("Estimated slope")
axes[0].legend(loc="lower right", fontsize=8.5, frameon=False)
fig.text(0.5, -0.02, "Parent income is the 1968-1972 average. Shaded band is the 95% confidence interval.",
ha="center", fontsize=9, color="gray")
fig.tight_layout()
fig.savefig(RESULTS_DIR / "fig1_lifecycle.png", dpi=200, bbox_inches="tight")
plt.close(fig)
# figure 2: binned scatter of child rank on parent rank (long-run measures)
d = common.copy()
d["parent_rank"] = d["p_inc_avg"].rank(pct=True) * 100
d["child_rank"] = d["c_inc_avg"].rank(pct=True) * 100
d["bin"] = pd.qcut(d["parent_rank"], 20, labels=False)
bins = d.groupby("bin")[["parent_rank", "child_rank"]].mean()
slope, _, _ = ols(d["child_rank"].values, d["parent_rank"].values)
intercept = d["child_rank"].mean() - slope * d["parent_rank"].mean()
fig, ax = plt.subplots(figsize=(6, 5))
ax.scatter(bins["parent_rank"], bins["child_rank"], color="#2a6f97", s=30)
xs = np.array([0, 100])
ax.plot(xs, intercept + slope * xs, color="#c44536",
label=f"Slope = {slope:.2f}")
ax.plot(xs, xs, color="gray", linestyle=":", label="No mobility (slope = 1)")
ax.axhline(50, color="lightgray", linewidth=0.8)
ax.set_xlim(0, 100)
ax.set_ylim(0, 100)
ax.set_xlabel("Parent income rank (1968-1972 average)")
ax.set_ylabel("Child income rank (ages 35-44 average)")
ax.set_title("Child income rank by parent income rank")
ax.legend(frameon=False, loc="upper left")
ax.grid(alpha=0.3)
fig.tight_layout()
fig.savefig(RESULTS_DIR / "fig2_rank_rank.png", dpi=200)
plt.close(fig)
print("Saved results to", RESULTS_DIR)
# Read the PSID Data Center extract and save it as a small SQLite database.
# Run from the project folder: python scripts/01_load_to_sqlite.py
from pathlib import Path
import re
import sqlite3
import zipfile
import pandas as pd
RAW_DIR = Path("data/raw")
DB_FILE = Path("data/psid.db")
def read_psid_extract():
# The Data Center gives a zip with a fixed-width text file (.txt) and a
# Stata do-file (.do). The do-file says where each variable sits in a line,
# for example "ER30001  2 - 5" means columns 2 to 5.
# works with the zip file or with the unzipped folder
zips = list(RAW_DIR.glob("*.zip"))
if zips:
z = zipfile.ZipFile(zips[0])
do_name = [n for n in z.namelist() if n.endswith(".do") and "formats" not in n][0]
txt_name = [n for n in z.namelist() if n.endswith(".txt")][0]
do_text = z.read(do_name).decode("latin-1")
txt_file = z.open(txt_name)
else:
do_file = [f for f in RAW_DIR.rglob("*.do") if "formats" not in f.name][0]
txt_name = do_file.with_suffix(".txt")
do_text = do_file.read_text(encoding="latin-1")
txt_file = open(txt_name, "rb")
print("Reading", txt_name)
infix = do_text[do_text.lower().index("infix"):do_text.lower().index("using")]
positions = re.findall(r"(\w+)\s+(\d+)\s*-\s*(\d+)", infix)
# keep only the variables we need
var_map = pd.read_csv("data/psid_variables.csv", dtype=str).fillna("")
needed = {"ER30001", "ER30002", "ER32000"}
for col in ["interview_no", "sequence_no", "relation_to_head", "age", "family_income"]:
needed.update(v for v in var_map[col] if v)
names, colspecs = [], []
for name, first, last in positions:
if name.upper() in needed:
names.append(name.upper())
colspecs.append((int(first) - 1, int(last)))
missing = needed - set(names)
if missing:
raise ValueError(f"These variables are not in the download: {sorted(missing)}")
data = pd.read_fwf(txt_file, colspecs=colspecs, names=names, header=None)
txt_file.close()
return data
wide = read_psid_extract().copy()
wide.columns = [c.upper() for c in wide.columns]
print("Raw extract:", wide.shape[0], "people,", wide.shape[1], "columns")
# variable names for each year (from the PSID cross-year index)
var_map = pd.read_csv("data/psid_variables.csv", dtype=str).fillna("")
# one row per person
# person id = 1968 interview number * 1000 + person number
wide["pid"] = wide["ER30001"] * 1000 + wide["ER30002"]
persons = pd.DataFrame({
"pid": wide["pid"],
"id1968": wide["ER30001"],
"sex": wide["ER32000"],
})
# one row per person and year (wide -> long)
rows = []
for _, v in var_map.iterrows():
year = int(v["year"])
one = pd.DataFrame({
"pid": wide["pid"],
"year": year,
"family_id": wide[v["interview_no"]],
"relation": wide[v["relation_to_head"]],
"age": wide[v["age"]],
"family_income": wide[v["family_income"]],
})
# 1968 has no sequence number; a person was in a 1968 family
# if their relation to head is not 0
if v["sequence_no"] == "":
one["seq"] = (one["relation"] > 0).astype(int)
else:
one["seq"] = wide[v["sequence_no"]]
rows.append(one)
person_years = pd.concat(rows, ignore_index=True)
# keep people who actually lived in a PSID family that year (sequence 1-20)
person_years = person_years[
(person_years["family_id"] > 0)
& (person_years["seq"] >= 1)
& (person_years["seq"] <= 20)
]
# the codes for relation to head changed in 1983 (1 -> 10, 2 -> 20, 3 -> 30)
person_years["role"] = "other"
person_years.loc[person_years["relation"].isin([1, 10]), "role"] = "head"
person_years.loc[person_years["relation"].isin([2, 20, 22]), "role"] = "spouse"
person_years.loc[person_years["relation"].isin([3, 30]), "role"] = "child"
# 9999999 is a missing value code for family income in 1994 and 1995
person_years.loc[person_years["family_income"] >= 9999999, "family_income"] = None
# age 0 or 999 means missing
person_years.loc[(person_years["age"] == 0) | (person_years["age"] >= 999), "age"] = None
print("Person-year rows:", len(person_years))
if DB_FILE.exists():
DB_FILE.unlink()
conn = sqlite3.connect(DB_FILE)
persons.to_sql("persons", conn, index=False)
person_years.to_sql("person_years", conn, index=False)
# family table: one row per family and year
conn.execute("""
CREATE TABLE families AS
SELECT
year,
family_id,
MAX(family_income) AS family_income,
COUNT(*) AS family_size
FROM person_years
GROUP BY year, family_id;
""")
conn.execute("CREATE INDEX idx_py ON person_years (year, family_id);")
conn.execute("CREATE INDEX idx_py_pid ON person_years (pid);")
conn.execute("CREATE INDEX idx_fam ON families (year, family_id);")
conn.commit()
for t in ["persons", "person_years", "families"]:
n = conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
print(t, n)
conn.close()
print("Saved", DB_FILE)
from pathlib import Path
import re
import sqlite3
import pandas as pd
RAW_TXT = Path("data/raw/J366557/J366557.txt")
RAW_DO = Path("data/raw/J366557/J366557.do")
DB_FILE = Path("data/psid.db")
var_map = pd.read_csv("data/psid_variables.csv", dtype=str).fillna("")
needed = {"ER30001", "ER30002", "ER32000"}
for col in ["interview_no", "sequence_no", "relation_to_head", "age", "family_income"]:
needed.update(v for v in var_map[col] if v)
do_text = RAW_DO.read_text(encoding="latin-1")
infix = do_text[do_text.index("infix"):do_text.index("using")]
positions = re.findall(r"(\w+)\s+(\d+)\s*-\s*(\d+)", infix)
names = []
colspecs = []
for name, first, last in positions:
if name in needed:
names.append(name)
colspecs.append((int(first) - 1, int(last)))
missing = needed - set(names)
if missing:
raise ValueError(f"Missing variables: {sorted(missing)}")
wide = pd.read_fwf(RAW_TXT, colspecs=colspecs, names=names, header=None)
print("People:", len(wide), "Variables:", len(names))
wide["pid"] = wide["ER30001"] * 1000 + wide["ER30002"]
persons = pd.DataFrame({
"pid": wide["pid"],
"id1968": wide["ER30001"],
"sex": wide["ER32000"],
})
rows = []
for _, v in var_map.iterrows():
one = pd.DataFrame({
"pid": wide["pid"],
"year": int(v["year"]),
"family_id": wide[v["interview_no"]],
"relation": wide[v["relation_to_head"]],
"age": wide[v["age"]],
"family_income": wide[v["family_income"]],
})
if v["sequence_no"] == "":
one["seq"] = (one["relation"] > 0).astype(int)
else:
one["seq"] = wide[v["sequence_no"]]
rows.append(one)
person_years = pd.concat(rows, ignore_index=True)
person_years = person_years[
(person_years["family_id"] > 0)
& (person_years["seq"].between(1, 20))
].copy()
person_years["role"] = "other"
person_years.loc[person_years["relation"].isin([1, 10]), "role"] = "head"
person_years.loc[person_years["relation"].isin([2, 20, 22]), "role"] = "spouse"
person_years.loc[person_years["relation"].isin([3, 30]), "role"] = "child"
person_years.loc[person_years["family_income"] >= 9999999, "family_income"] = None
person_years.loc[(person_years["age"] == 0) | (person_years["age"] >= 999), "age"] = None
print("Person-years:", len(person_years))
if DB_FILE.exists():
DB_FILE.unlink()
conn = sqlite3.connect(DB_FILE)
persons.to_sql("persons", conn, index=False)
person_years.to_sql("person_years", conn, index=False)
conn.execute("""
CREATE TABLE families AS
SELECT
year,
family_id,
MAX(family_income) AS family_income,
COUNT(*) AS family_size
FROM person_years
GROUP BY year, family_id;
""")
conn.execute("CREATE INDEX idx_py ON person_years (year, family_id);")
conn.execute("CREATE INDEX idx_py_pid ON person_years (pid);")
conn.execute("CREATE INDEX idx_fam ON families (year, family_id);")
conn.commit()
for table in ["persons", "person_years", "families"]:
n = conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]
print(table, n)
conn.close()
print("Saved", DB_FILE)
library(reticulate)
py_require(c("pandas", "numpy", "matplotlib"))
py_run_file("scripts/01_load_to_sqlite.py")
py_run_file("scripts/02_match_with_sql.py")
py_run_file("scripts/03_estimate_ige.py")
reticulate::repl_python()
